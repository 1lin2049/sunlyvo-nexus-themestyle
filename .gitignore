# ═══════════════════════════════════════════════════
# SunLyvo Nexus — Git Ignore
# ═══════════════════════════════════════════════════

# ─── Node / 前端构建 ───────────────────────────────
node_modules/
**/node_modules/
.pnpm-store/
**/.pnpm/
dist/
build/
.next/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo

# ─── 环境变量 ──────────────────────────────────────
.env
.env.*
!.env.example

# ─── Python / 虚拟环境 ─────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ─── PHP / Composer ────────────────────────────────
/vendor/
composer.lock

# ─── 打包产物 ──────────────────────────────────────
*.zip
*.tar.gz
*.rar
*.7z

# ─── 日志 ──────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ─── 密钥 / 敏感文件 ───────────────────────────────
wp-config.php
wp-config.php.bak
wp-config.php.save
wp-config.php.orig
*.sql
*.sql.gz
slv-encryption.key
wp-content/slv-keys/
wp-content/slv-private/

# ─── 上传文件 ──────────────────────────────────────
wp-content/uploads/
uploads/

# ─── 缓存 / 运行时 ─────────────────────────────────
wp-content/cache/
wp-content/upgrade/
wp-content/updraft/
wp-content/ai1wm-backups/
*.cache
.DS_Store
Thumbs.db

# ─── IDE / 编辑器 ──────────────────────────────────
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# ─── 测试覆盖率 ────────────────────────────────────
coverage/
.nyc_output/

# ─── 构建报告 ──────────────────────────────────────
wp-content/slv-reports/