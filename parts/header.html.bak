<!-- wp:group {"className":"slv-header","layout":{"type":"default"}} -->
<div class="wp-block-group slv-header">
    <!-- wp:group {"className":"slv-header__inner","layout":{"type":"flex","flexWrap":"nowrap","justifyContent":"space-between","verticalAlignment":"center"}} -->
    <div class="wp-block-group slv-header__inner">
        <!-- wp:site-logo {"width":140,"className":"slv-header__logo"} /-->

        <!-- wp:navigation {"className":"slv-header__nav","overlayMenu":"mobile","icon":"menu","layout":{"type":"flex","justifyContent":"center","flexWrap":"nowrap"}} -->
            <!-- wp:navigation-link {"label":"首页","url":"/","kind":"custom","isTopLevel":true} /-->
            <!-- wp:navigation-link {"label":"博客","url":"/blog/","kind":"custom","isTopLevel":true} /-->
            <!-- wp:navigation-link {"label":"百科","url":"/wiki/","kind":"custom","isTopLevel":true} /-->
            <!-- wp:navigation-link {"label":"FAQ","url":"/faq/","kind":"custom","isTopLevel":true} /-->
